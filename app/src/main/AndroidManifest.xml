<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Required to resolve host app icons and launcher activities on Android 11+. -->
    <queries>
        <package android:name="com.ss.android.ugc.aweme" />
        <package android:name="com.tencent.mm" />
        <package android:name="com.tencent.mobileqq" />
    </queries>

    <application

        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:description="@string/xposed_description"
        android:supportsRtl="true"
        android:theme="@style/Theme.DAuxiliary"
        tools:targetApi="31">

        <!-- Main UI entry (Compose + Miuix) -->
        <activity
            android:name=".ui.MainActivity"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Module settings screen launched from QQ's native settings item. -->
        <activity
            android:name=".ui.HostSettingsActivity"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.DAuxiliary" />

        <provider
            android:name=".core.config.ModuleStatusProvider"
            android:authorities="com.dauxiliary.status"
            android:exported="true"
            android:grantUriPermissions="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- LibXposed reads module entry, scope and API level from META-INF/xposed. -->
        <meta-data
            android:name="xposedmodule"
            android:value="true"
            tools:replace="android:value" />
    </application>

</manifest>
